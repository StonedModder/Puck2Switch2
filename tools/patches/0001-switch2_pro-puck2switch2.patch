+void Switch2Pro::on_vibration_write(const uint8_t *data, size_t len) {
+  // This path was silent below 13 bytes, which made a wrong-length or
+  // report-id-less frame undiagnosable. Log every write (rate-limited) so a live
+  // capture always shows whether the console is talking to us at all.
+  static uint32_t writes = 0;
+  const bool log_now = writes < 8 || (writes % 200) == 0;
+  if (log_now) {
+    const uint8_t b0 = len > 0 ? data[0] : 0;
+    const uint8_t b1 = len > 1 ? data[1] : 0;
+    const uint8_t b2 = len > 2 ? data[2] : 0;
+    logger_.info("vib write #{} len={} b={:02x} {:02x} {:02x} seq@1={}", writes, len, b0, b1, b2,
+                 (b1 & 0xF0) == 0x50 ? "ok" : "NO");
+  }
+  ++writes;
+  if (!on_vibration || len < 13) return;
+  on_vibration(data, len);
+}
