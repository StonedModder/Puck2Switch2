+// ---------------------------------------------------------------------------
+// Common input report (id 0x05, GATT handle 0x000a)
+// ---------------------------------------------------------------------------
+
+/// Map a 0..9 battery-level nibble to a plausible 1S Li-ion cell voltage in mV.
+///
+/// The Switch 2 controller protocol reports battery as a VOLTAGE on the common
+/// input report (offset 0x1f) and on command 0x0b/0x03, while the Pro
+/// Controller 2 input report (0x09) carries a coarse 0..9 nibble. The adapter
+/// only ever learns a percentage from the Steam Controller, so the voltage has
+/// to be synthesised from that nibble; a linear 3.30 V (empty) .. 4.20 V (full)
+/// ramp is used. The absolute curve is NOT from a capture (the one captured
+/// example, 0x0ea5 = 3749 mV, falls inside this range at roughly half charge),
+/// so treat the exact millivolts as an estimate — what matters is that it is
+/// never 0, which reads as a dead cell.
+inline uint16_t battery_level_to_mv(uint8_t level_0_9) {
+  if (level_0_9 > 9)
+    level_0_9 = 9;
+  return static_cast<uint16_t>(3300 + level_0_9 * 100); // 3300..4200 mV
+}
+
+/// Charge-status byte for the common input report / command 0x0b sub 0x04.
+/// 0x34 observed while charging over USB, 0x20 when fully charged. There is no
+/// capture for "running on battery, no charger", so 0x00 is used there.
+inline uint8_t charge_status_byte(bool charging, bool external_power) {
+  if (charging)
+    return 0x34;
+  if (external_power)
+    return 0x20;
+  return 0x00;
+}
+
+/// Size of input report 0x05 on BLE (report-id byte omitted), same as 0x09.
+inline constexpr size_t COMMON_INPUT_SIZE = 63;
+
+/// Build the common input report (0x05) that handle 0x000a exposes, deriving
+/// every field from a Pro Controller 2 report (0x09) so the two can never
+/// disagree.
+///
+/// Why this exists: handle 0x000a is created READ | NOTIFY, and until now it was
+/// never written at all — a GATT read returned an empty value with no voltage
+/// field. Whether the console reads it, or interprets an empty value as a low
+/// battery, is unknown. Layout per ndeadly/switch2_controller_research hid_reports.md
+/// "Input Report 0x05".
+///
+/// @param src      the Pro Controller 2 report currently being streamed
+/// @param counter  32-bit report counter (increments once per report)
+/// @param out      destination buffer, COMMON_INPUT_SIZE bytes
+inline void build_common_input_report(const Pro2InputReport &src, uint32_t counter,
+                                      std::array<uint8_t, COMMON_INPUT_SIZE> &out) {
+  out.fill(0);
+  const auto &d = src.data();
+
+  // 0x00..0x03 — 32-bit LE report counter.
+  out[0x00] = static_cast<uint8_t>(counter & 0xff);
+  out[0x01] = static_cast<uint8_t>((counter >> 8) & 0xff);
+  out[0x02] = static_cast<uint8_t>((counter >> 16) & 0xff);
+  out[0x03] = static_cast<uint8_t>((counter >> 24) & 0xff);
+
+  // 0x04..0x07 — buttons. Report 0x05 uses a DIFFERENT bit layout from 0x09,
+  // so this is an explicit remap, not a copy.
+  //   0x05 byte 0: 0x80 ZR 0x40 R 0x20 SL-R 0x10 SR-R 0x08 A 0x04 B 0x02 X 0x01 Y
+  //   0x05 byte 1: 0x40 C 0x20 Capture 0x10 Home 0x08 LStick 0x04 RStick 0x02 Plus 0x01 Minus
+  //   0x05 byte 2: 0x80 ZL 0x40 L 0x20 SL-L 0x10 SR-L 0x08 Left 0x04 Right 0x02 Up 0x01 Down
+  //   0x05 byte 3: 0x10 Headset 0x02 GL 0x01 GR
+  const uint8_t b2 = d[2], b3 = d[3], b4 = d[4];
+  uint8_t o0 = 0, o1 = 0, o2 = 0, o3 = 0;
+  if (b2 & 0x20) o0 |= 0x80; // ZR
+  if (b2 & 0x10) o0 |= 0x40; // R
+  if (b2 & 0x02) o0 |= 0x08; // A
+  if (b2 & 0x01) o0 |= 0x04; // B
+  if (b2 & 0x08) o0 |= 0x02; // X
+  if (b2 & 0x04) o0 |= 0x01; // Y
+  if (b4 & 0x10) o1 |= 0x40; // C
+  if (b4 & 0x02) o1 |= 0x20; // Capture
+  if (b4 & 0x01) o1 |= 0x10; // Home
+  if (b3 & 0x80) o1 |= 0x08; // left stick click
+  if (b2 & 0x80) o1 |= 0x04; // right stick click
+  if (b2 & 0x40) o1 |= 0x02; // Plus
+  if (b3 & 0x40) o1 |= 0x01; // Minus
+  if (b3 & 0x20) o2 |= 0x80; // ZL
+  if (b3 & 0x10) o2 |= 0x40; // L
+  if (b3 & 0x04) o2 |= 0x08; // Left
+  if (b3 & 0x02) o2 |= 0x04; // Right
+  if (b3 & 0x08) o2 |= 0x02; // Up
+  if (b3 & 0x01) o2 |= 0x01; // Down
+  if (b4 & 0x08) o3 |= 0x02; // GL
+  if (b4 & 0x04) o3 |= 0x01; // GR
+  out[0x04] = o0;
+  out[0x05] = o1;
+  out[0x06] = o2;
+  out[0x07] = o3;
+
+  // 0x0a..0x0f — sticks. Both reports pack two 12-bit axes into 3 bytes the
+  // same way, so the 0x09 bytes carry over unchanged.
+  out[0x0a] = d[5];
+  out[0x0b] = d[6];
+  out[0x0c] = d[7];
+  out[0x0d] = d[8];
+  out[0x0e] = d[9];
+  out[0x0f] = d[10];
+
+  // 0x1f..0x21 — estimated voltage and charge state derived from report 0x09.
+  const uint16_t mv = battery_level_to_mv(src.battery_level());
+  out[0x1f] = static_cast<uint8_t>(mv & 0xff);
+  out[0x20] = static_cast<uint8_t>(mv >> 8);
+  out[0x21] = charge_status_byte(src.is_charging(), src.has_external_power());
+
+  // 0x29 — documented as always 0x01 on a real controller.
+  out[0x29] = 0x01;
+}
+
 } // namespace espp::switch2
